{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "rustashop admin",
  "version": "0.1.0",
  "identifier": "ai.rustashop.admin",
  "build": {
    "beforeDevCommand": {
      "script": "trunk serve --release --port 4251 --address 127.0.0.1",
      "cwd": "../leptos-rangular"
    },
    "devUrl": "http://127.0.0.1:4251",
    "beforeBuildCommand": {
      "script": "trunk build --release",
      "cwd": "../leptos-rangular"
    },
    "frontendDist": "../leptos-rangular/dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "rustashop admin",
        "width": 1100,
        "height": 760,
        "minWidth": 880,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; connect-src 'self' ipc: http://ipc.localhost http: https:; font-src 'self' data:; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
