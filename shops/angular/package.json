{
  "name": "@rustashop/shop-angular",
  "version": "0.1.0",
  "scripts": {
    "ng": "ng",
    "template:emit": "node scripts/emit-template.mjs",
    "prestart": "npm run template:emit",
    "prebuild": "npm run template:emit",
    "prelint": "npm run template:emit",
    "pretest": "npm run template:emit",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:coverage": "ng test --coverage --coverage-reporters=lcov --coverage-reporters=text-summary",
    "lint": "ng lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generate:api": "node scripts/generate-api.mjs"
  },
  "private": true,
  "license": "OSL-3.0",
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "dependencies": {
    "@angular/common": "^22.1.5",
    "@angular/compiler": "^22.1.5",
    "@angular/core": "^22.1.5",
    "@angular/forms": "^22.1.5",
    "@angular/platform-browser": "^22.1.5",
    "@angular/router": "^22.1.5",
    "@rustashop/template-shop-default": "file:../../templates/shop/default",
    "bootstrap": "5.3",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular-eslint/builder": "^22.2.0",
    "@angular/build": "^22.1.7",
    "@angular/cli": "^22.1.7",
    "@angular/compiler-cli": "^22.1.5",
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "4.1.11",
    "angular-eslint": "^22.2.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^30.0.1",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.6",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "esbuild@0.28.2": true,
    "lmdb@3.5.6": true,
    "msgpackr-extract@3.0.4": true
  }
}
