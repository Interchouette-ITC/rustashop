    "/healthz": {
      "get": {
        "tags": [
          "crate::health"
        ],
        "summary": "`GET /healthz` `OpenAPI` path (served by the Serenade HTTP front controller).",
        "operationId": "healthz",
        "responses": {
          "200": {
            "description": "Process is up",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
