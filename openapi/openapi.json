  "components": {
    "schemas": {
      "AddCartLineRequest": {
        "type": "object",
        "description": "Body for `POST /v1/carts/{id}/lines`.",
        "required": [
          "variant_id",
          "quantity"
        ],
        "properties": {
          "quantity": {
            "type": "integer",
            "format": "int32",
            "description": "Quantity greater than zero."
          },
          "variant_id": {
            "type": "string",
            "description": "Variant to add."
          }
        }
      },
      "CartLineResponse": {
        "type": "object",
        "description": "Cart line JSON.",
        "required": [
          "id",
          "variant_id",
          "quantity",
          "unit_price",
          "line_total",
          "product_name",
          "variant_sku"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "Line id."
          },
          "line_total": {
            "$ref": "#/components/schemas/MoneyResponse",
            "description": "Line total (`unit_price × quantity`)."
          },
          "product_name": {
            "type": "string",
            "description": "Snapshotted product name."
          },
          "quantity": {
            "type": "integer",
            "format": "int32",
            "description": "Quantity."
          },
          "unit_price": {
            "$ref": "#/components/schemas/MoneyResponse",
            "description": "Snapshotted unit price."
          },
          "variant_id": {
            "type": "string",
            "description": "Variant id."
          },
          "variant_sku": {
            "type": "string",
            "description": "Snapshotted SKU."
          }
        }
      },
      "CartResponse": {
        "type": "object",
        "description": "Cart JSON including recalculated totals.",
        "required": [
          "id",
          "token",
          "status",
          "currency",
          "lines",
          "items_total"
        ],
        "properties": {
          "currency": {
            "type": "string",
            "description": "Cart currency."
          },
          "customer_id": {
            "type": [
              "string",
              "null"
            ],
            "description": "Optional customer id."
          },
          "id": {
            "type": "string",
            "description": "Cart id."
          },
          "items_total": {
            "$ref": "#/components/schemas/MoneyResponse",
            "description": "Sum of line totals."
          },
          "lines": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CartLineResponse"
            },
            "description": "Cart lines."
          },
          "status": {
            "type": "string",
            "description": "Cart status (`open` or `checked_out`)."
          },
          "token": {
            "type": "string",
            "description": "Session token."
          }
        }
      },
      "CheckoutRequest": {
        "type": "object",
        "description": "Body for `POST /v1/checkout`.",
        "required": [
          "cart_id"
        ],
        "properties": {
          "cart_id": {
            "type": "string",
            "description": "Cart to convert into an order."
          }
        }
      },
      "CreateCartRequest": {
        "type": "object",
        "description": "Body for `POST /v1/carts`.",
        "properties": {
          "currency": {
            "type": [
              "string",
              "null"
            ],
            "description": "ISO currency for the cart (default `EUR`)."
          }
        }
      },
      "CreateSandboxJobRequest": {
        "type": "object",
        "description": "Request body for creating a sandbox job.",
        "required": [
          "job_type",
          "currency",
          "lines"
        ],
        "properties": {
          "currency": {
            "type": "string",
            "description": "Cart currency for the quote fixture."
          },
          "job_type": {
            "type": "string",
            "description": "Job type (`quote` only)."
          },
          "lines": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SandboxJobLine"
            },
            "description": "Cart lines for the guest snapshot."
          }
        }
      },
      "ErrorBody": {
        "type": "object",
        "description": "JSON error body (message + stable machine code).",
        "required": [
          "error",
          "code"
        ],
        "properties": {
          "code": {
            "type": "string",
            "description": "Stable machine-readable code (`not_found`, `conflict`, …)."
          },
          "error": {
            "type": "string",
            "description": "Human-readable error message."
          }
        }
      },
      "HealthResponse": {
        "type": "object",
        "description": "JSON body for `GET /healthz`.",
        "required": [
          "status",
          "kernel"
        ],
        "properties": {
          "kernel": {
            "type": "string",
            "description": "Serenade kernel integration marker from the `rustashop` crate (`serenade` after boot)."
          },
          "status": {
            "type": "string",
            "description": "Liveness status."
          }
        }
      },
      "MoneyResponse": {
        "type": "object",
        "description": "Money JSON for cart responses.",
        "required": [
          "amount_minor",
          "currency"
        ],
        "properties": {
          "amount_minor": {
            "type": "integer",
            "format": "int64",
